# Copiar este archivo como .env o configurar estas variables en el sistema.
# NUNCA commitear valores reales.

# Cadena de conexion de Supabase (PostgreSQL)
# Formato: Host=db.xxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=TU_PASSWORD
CONNECTION_STRING=Host=db.YOUR_PROJECT.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD

# Clave secreta para firmar los JWT (minimo 32 caracteres, generarla con: openssl rand -base64 32)
JWT_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Tiempo de vida del JWT en horas
JWT_EXPIRES_HOURS=24

# API Key de Anthropic (para categorizacion con IA en Import y Chat)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Entorno de ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
